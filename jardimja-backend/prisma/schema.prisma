datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Usuario {
  id       Int      @id @default(autoincrement())
  nome     String
  email    String   @unique
  senha    String
  perfil   String // "cliente" ou "jardineiro"
  criadoEm DateTime @default(now())

  solicitacoesCliente    Solicitacao[] @relation("Cliente")
  solicitacoesJardineiro Solicitacao[] @relation("Jardineiro")
}

model TipoServico {
  id           Int           @id @default(autoincrement())
  nome         String
  solicitacoes Solicitacao[]
}

model Solicitacao {
  id           Int      @id @default(autoincrement())
  descricao    String?
  endereco     String
  status       String   @default("pendente")
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  clienteId Int
  cliente   Usuario @relation("Cliente", fields: [clienteId], references: [id])

  jardineiroId Int?
  jardineiro   Usuario? @relation("Jardineiro", fields: [jardineiroId], references: [id])

  tipoId Int
  tipo   TipoServico @relation(fields: [tipoId], references: [id])
}
